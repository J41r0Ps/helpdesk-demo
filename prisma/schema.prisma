// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MANAGER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProblemType {
  MECHANICAL
  SOFTWARE
  IMAGE_QUALITY
  CONNECTIVITY
  OTHER
}

enum AuthorType {
  CUSTOMER
  SUPPORT
}

model Organization {
  id       String    @id @default(cuid())
  name     String
  users    User[]
  machines Machine[]
  tickets  Ticket[]
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  role           Role         @default(USER)
  active         Boolean      @default(true) // people come and go: deactivate, never delete
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tickets        Ticket[]     @relation("CreatedTickets")
}

model Machine {
  id             String       @id @default(cuid())
  name           String
  serialNumber   String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tickets        Ticket[]
}

model Ticket {
  id             String       @id @default(cuid())
  externalId     String?      @unique // id of this ticket in the external ticket system
  subject        String
  description    String
  status         TicketStatus @default(OPEN)
  priority       Priority     @default(MEDIUM)
  problemType    ProblemType
  since          DateTime // "since when does the problem occur?"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  // organizationId is stored on the ticket itself, so a manager keeps seeing it
  // even if the reporter later leaves or moves to another organization.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdById    String
  createdBy      User         @relation("CreatedTickets", fields: [createdById], references: [id], onDelete: Restrict)
  machineId      String?
  machine        Machine?     @relation(fields: [machineId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@index([organizationId, status])
  @@index([createdById])
}

model Message {
  id         String     @id @default(cuid())
  ticketId   String
  ticket     Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType AuthorType
  authorName String
  body       String
  createdAt  DateTime   @default(now())
}

// Every processed webhook is stored once: the unique eventId makes processing idempotent.
model WebhookEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  type       String
  receivedAt DateTime @default(now())
}
